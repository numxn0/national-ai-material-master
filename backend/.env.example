# National AI Material Master - Backend Environment Configuration
PROJECT_NAME="National AI Material Master"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# API Gateway
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Target (Supabase PostgreSQL + pgvector)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# AI Inference Settings (Planned for future sprints)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
FUZZY_THRESHOLD=85
XGBOOST_CONFIDENCE_THRESHOLD=0.80
